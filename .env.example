# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Vector store
CHROMA_PERSIST_DIR=chroma_db

# API authentication (comma-separated; add multiple keys for rotation)
SENTINEL_API_KEYS=change-me-in-production

# Application
APP_ENV=development
LOG_LEVEL=INFO
